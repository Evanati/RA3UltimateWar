		<!-- Base Object -->
		<Include type="instance" source="DATA:BaseObjects/BaseStructure.xml" />
	</Includes>
	
	<GameObject
		id="AlliedBaseDefenseRT"
		inheritFrom="BaseStructure"
		SelectPortrait="Portrait_AlliedBaseDefenseRT"
		ButtonImage="Portrait_AlliedBaseDefenseRT"
		Side="Allies"
		HealthBoxHeightOffset="20"
		EditorSorting="STRUCTURE"		
		BuildTime="25"
		EnergyProduction="-30"
		CommandSet=""
		KindOf="-NOT_AUTOACQUIRABLE +FS_BASE_DEFENSE +POWERED"
		RadarPriority="STRUCTURE"
		PlacementViewAngle="225d"
		CampnessValue="3000"
		CampnessValueRadius="200"
		ProductionQueueType="OTHER_STRUCTURE"
		BuildPlacementTypeFlag="OTHER_STRUCTURE"
		EditorName="AlliedBaseDefenseRT"
		WeaponCategory="NONE"
		TypeDescription="Type:AlliedBaseDefenseRT"
		Description="Desc:AlliedBaseDefenseRT">
		<DisplayName
			xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance">Name:AlliedBaseDefenseRT</DisplayName>
		<GameDependency>
			<RequiredObject>AlliedPowerPlant</RequiredObject>
		</GameDependency>
		<ObjectResourceInfo>
			<BuildCost Account="=$ACCOUNT_ORE" Amount="1000"/>
		</ObjectResourceInfo>
		<ArmorSet
			Armor="AlliedPrimaryBaseDefenseArmor"
			DamageFX="FactionStructureDamageFX" />
		<SkirmishAIInformation
			BaseBuildingLocation="CENTER" >
			<ConstructionBaseSelectionCriteria
				ExcludedBaseTypes="NO_BUILD_RADIUS"
				PreferredBaseTypes="ENEMIES_IN_BASE UNDER_ATTACK"
				SortOrder="PREFER_MOST_RECENTLY_ATTACKED" />
		</SkirmishAIInformation>
		<Draws>
			<!-- DRAW GUN -->
			<ScriptedModelDraw
				id="ModuleTag_Draw_Gun"
				OkToChangeModelColor="true"
				ExtraPublicBone="UPGRADE_DEFAULT_MISSILE BONE_CONTACT_POINT_01 BONE_CONTACT_POINT_02 BONE_CONTACT_POINT_03 BONE_CONTACT_POINT_04">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="ABBaseDefense" />
					<WeaponFireFXBone
						WeaponSlotType="PRIMARY_WEAPON"
						BoneName="UPGRADE_DEFAULT_MISSILE" />
					<WeaponLaunchBone
						WeaponSlotType="PRIMARY_WEAPON"
						BoneName="UPGRADE_DEFAULT_MISSILE" />
					<Turret
						TurretNameKey="Turret"
						TurretPitch="Turret_Pitch"
						TurretID="1" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="BUILD_PLACEMENT_CURSOR">
					<Model
						Name="ABBaseDefense" />
				</ModelConditionState>        
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="STRUCTURE_UNPACKING">
					<Model
						Name="ABBaseDefense_BLD_SKN" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="SOLD">
					<Model
						Name="ABBaseDefense_BLD_SKN" />
				</ModelConditionState>					
				<AnimationState
					ParseCondStateType="PARSE_DEFAULT">
				</AnimationState>

				<AnimationState
					ParseCondStateType="PARSE_NORMAL"  
					ConditionsYes="BUILD_PLACEMENT_CURSOR">
					<Script>
						CurDrawableHideSubObjectPermanently("Upgrade_Default_Missile")
						CurDrawableHideSubObjectPermanently("Upgrade_Blaster_Rifles")
						CurDrawableHideSubObjectPermanently("Upgrade_Flak")
						CurDrawableHideSubObjectPermanently("Upgrade_GoldenGun")
						CurDrawableHideSubObjectPermanently("Upgrade_MachineGun")
						CurDrawableHideSubObjectPermanently("Upgrade_MissileLauncher")
						CurDrawableHideSubObjectPermanently("Upgrade_Natasha_Sniper")
						CurDrawableHideSubObjectPermanently("Upgrade_Ninja_Star")
						CurDrawableHideSubObjectPermanently("Upgrade_Plasma")
						CurDrawableHideSubObjectPermanently("Upgrade_Psyonic")
						CurDrawableHideSubObjectPermanently("Upgrade_Psyonic_Turret")
						CurDrawableHideSubObjectPermanently("Upgrade_Shotgun")
						CurDrawableHideSubObjectPermanently("Upgrade_Speakers")
						CurDrawableHideSubObjectPermanently("Upgrade_Tesla")
						CurDrawableHideSubObjectPermanently("Upgrade_Tesla_Turret")
						CurDrawableHideSubObjectPermanently("Upgrade_Turret")
					</Script>
				</AnimationState>									

				<AnimationState
					ParseCondStateType="PARSE_NORMAL"  
					ConditionsYes="OVER_WATER STRUCTURE_UNPACKING ">
					<Animation
						AnimationName="ABBaseDefense_BLD_BLDW"
						AnimationBlendTime="0"
						AnimationMode="ONCE"
						AnimationAbsoluteTime="0.2s"/>
				</AnimationState>									
				<AnimationState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="STRUCTURE_UNPACKING">
					<Animation
						AnimationName="ABBaseDefense_BLD_BLD"
						AnimationBlendTime="0"
						AnimationMode="ONCE"
						AnimationAbsoluteTime="0.2s" />
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="SOLD"
					Flags="START_FRAME_LAST">
					<Animation
						AnimationName="ABBaseDefense_BLD_BLD"
						AnimationMode="ONCE_BACKWARDS"
						AnimationAbsoluteTime="2s"/>
				</AnimationState>										
			</ScriptedModelDraw>

<!-- DRAW PLATFORM -->

			<ScriptedModelDraw
				id="ModuleTag_Draw_Platform"
				OkToChangeModelColor="true">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="ABBaseDefense_Platform" />
				</ModelConditionState>

				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="BUILD_PLACEMENT_CURSOR">
					<Model
						Name="ABBaseDefense_Platform" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="OVER_WATER STRUCTURE_UNPACKING">
					<Model
						Name="ABBaseDefense_Platform_BLD" />
						 <ParticleSysBone
						BoneName="None"
						FXParticleSystemTemplate="ABPowerPlantWakeSplash"
						FollowBone="true" />          
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="OVER_WATER SOLD">
					<Model
						Name="ABBaseDefense_Platform_BLD" />
					<ParticleSysBone
						 BoneName="None"
						 FXParticleSystemTemplate="ABPowerPlantWakeSplash"
						 FollowBone="true" />
				</ModelConditionState>					
				<AnimationState
					ParseCondStateType="PARSE_DEFAULT">
					<Script>
						CurDrawableShowSubObjectPermanently("Bib")
						CurDrawableHideSubObjectPermanently("Platform")
						CurDrawableHideSubObjectPermanently("Platform_FX")
					</Script>
				</AnimationState>	
				
					<!-- BUILDUP ANIMATION -->
				<AnimationState
					ParseCondStateType="PARSE_NORMAL"  
					ConditionsYes="STRUCTURE_UNPACKING OVER_WATER">
					<Animation
						AnimationName="ABBaseDefense_Platform_BLD"
						AnimationMode="ONCE" />
					<Script>
						CurDrawableHideSubObjectPermanently("Bib")
						CurDrawableShowSubObjectPermanently("Platform")
						CurDrawableShowSubObjectPermanently("Platform_FX")
					</Script>						
					<ParticleSysBone
						BoneName="None"
						FXParticleSystemTemplate="AlliedPowerPlantWaterBuildupFroth"
						FollowBone="true" />
					<ParticleSysBone
						BoneName="None"
						FXParticleSystemTemplate="AlliedPowerPlantWaterBuildupMist"
						FollowBone="true" />
				</AnimationState>	
				<AnimationState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="SOLD OVER_WATER"
					Flags="START_FRAME_LAST">
					<Animation
						AnimationName="ABBaseDefense_Platform_BLD"
						AnimationMode="ONCE_BACKWARDS"
						AnimationAbsoluteTime="2s"/>
					<ParticleSysBone
						BoneName="None"
						FXParticleSystemTemplate="AlliedPowerPlantWaterBuildupFroth"
						FollowBone="true" />
					<ParticleSysBone
						BoneName="None"
						FXParticleSystemTemplate="AlliedPowerPlantWaterBuildupMist"
						FollowBone="true" />
				</AnimationState>				
				<AnimationState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="OVER_WATER">
					<Script>
						CurDrawableShowSubObjectPermanently("Platform")
						CurDrawableShowSubObjectPermanently("Platform_FX")
						CurDrawableHideSubObjectPermanently("Bib")
					</Script>
				</AnimationState>		
			</ScriptedModelDraw>

<!-- DRAW PARTICLES -->

      <ScriptedModelDraw
				id="ModuleTag_Draw_FX"
				OkToChangeModelColor="true">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="ABRefinery_FX" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="DAMAGED">
					<Model
						Name="ABBaseDefense_FX" />
					<ParticleSysBone 
						BoneName="FX_BONE01" 
						FXParticleSystemTemplate="GenericDStateSmoke"
						FollowBone="true"/>
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="REALLYDAMAGED">
					<Model
						Name="ABBaseDefense_FX" />
					<ParticleSysBone 
						BoneName="FX_BONE01" 
						FXParticleSystemTemplate="GenericDStateSmoke"
						FollowBone="true"/>
					<ParticleSysBone 
						BoneName="FX_BONE01"
 						FXParticleSystemTemplate="GenericDStateFire"
						FollowBone="true"/>

				</ModelConditionState>
			</ScriptedModelDraw>
			
			<ScriptedModelDraw
				id="ModuleTag_RepairDecal"
				OkToChangeModelColor="true">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model Name="" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="SELECTED">
					<Model Name="FXInvisBone" />
					<ShadowInfo
						Type="ADDITIVE_DECAL"
						SizeX="150.0"
						SizeY="150.0"
						OverrideLODVisibility="true"
						MaxHeight="200"
						UseHouseColor="true"
						Texture="Decal_Rig_CO"
						LocalPlayerOnly="true" />
				</ModelConditionState>
			</ScriptedModelDraw>
		</Draws>
		
		<Behaviors>
			<WeaponSetUpdate
				id="ModuleTag_WeaponSetUpdate">
				<WeaponSlotTurret
					ID="1"
					AllowInterleavedFiring="false"
					InterleavedStyle="INTERLEAVE_FIRST_AVAILABLE"
					WeaponChoiceCriteria="PREFER_MOST_DAMAGE"
					AutoChooseWeapon="true">

					<!-- AlliedEngineer, SovietEngineer & JapanEngineer (default) -->
					<Weapon
						Template="ABD_RepairWeapon"
						Upgrade="Uprade_IFV_Repair"
						Ordering="PRIMARY_WEAPON"/>
					
					<TurretSettings
						TurretTurnRate="360"
						MinimumPitch="-30d"
						AllowsPitch="true" 
						TurretPitchRate="180" 
						MinIdleScanTime="1.0s"
						MaxIdleScanTime="4.0s"
						MinIdleScanAngle="30.0"
						MaxIdleScanAngle="50.0"
						ComeToHaltJiggle="3d">
						<TurretAITargetChooserData
							CanAcquireDynamicIfAssignedOutOfRange="true">
					</TurretAITargetChooserData>
					</TurretSettings>
				</WeaponSlotTurret>
			</WeaponSetUpdate>
			
			<LevelUpUpgrade
				id="ModuleTag_LevelUp_Veteran"
				RequiresAllTriggers="false"
				RequiresAllConflictingTriggers="false"
				Permanent="false"
				WaypointMode="false"
				WaypointModeTerminal="true"
				LevelsToGain="1"
				LevelCap="4"
				DoFlash="true">
				<TriggeredBy>Upgrade_CreationVeterancy_VETERAN</TriggeredBy>
			</LevelUpUpgrade>
			<LevelUpUpgrade
				id="ModuleTag_LevelUp_Elite"
				RequiresAllTriggers="false"
				RequiresAllConflictingTriggers="false"
				Permanent="false"
				WaypointMode="false"
				WaypointModeTerminal="true"
				LevelsToGain="1"
				LevelCap="4"
				DoFlash="true">
				<TriggeredBy>Upgrade_CreationVeterancy_ELITE</TriggeredBy>
			</LevelUpUpgrade>
			<LevelUpUpgrade
				id="ModuleTag_LevelUp_Heroic"
				RequiresAllTriggers="false"
				RequiresAllConflictingTriggers="false"
				Permanent="false"
				WaypointMode="false"
				WaypointModeTerminal="true"
				LevelsToGain="1"
				LevelCap="4"
				DoFlash="true">
				<TriggeredBy>Upgrade_CreationVeterancy_HEROIC</TriggeredBy>
			</LevelUpUpgrade>
			
			<StancesBehavior
				id="ModuleTag_Stance"
				StanceTemplate="OffensiveStructures" />
			
			<Physics
				id="ModuleTag_Physics"/>
				
			<BuildingDestructionBehavior
				id="ModuleTag_BuildingDestruction">
				<DieMuxData
					DeathTypes="ALL" />
				<Item
					BonePrefix="BONE_CONTACT_POINT_"
					FX="SovietRefineryHit"
					FlingVelocity="100.0"/>
			</BuildingDestructionBehavior>
			<FXListBehavior
				xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance" id="ModuleTag_FXList">
				<DieMuxData
					DeathTypes="ALL"
					DeathTypesForbidden="SUICIDED" />
				<Event
					Index="onDeath"
					FX="FX_None" />
			</FXListBehavior>
			<FXListBehavior xai:joinAction="Replace" xmlns:xai="uri:ea.com:eala:asset:instance" id="ModuleTag_DieSound">
				<DieMuxData 
					DeathTypes="ALL"
					DeathTypesForbidden="SUICIDED" />
				<Event Index="onDeath" FX="FX_SmallBuildingDieExplosion" />
			</FXListBehavior>
			<CreateObjectDie
				id="ModuleTag_CreateObjectDie"
				CreationList="ABBaseDefense_Die_OCL">
				<DieMuxData
					DeathTypes="ALL"
					DeathTypesForbidden="SUICIDED" />
			</CreateObjectDie>
			<DestroyDie
				id="ModuleTag_Die">
				<DieMuxData
					DeathTypes="ALL"
					DeathTypesForbidden="SUICIDED" />
			</DestroyDie>	
			
			<StructureUnpackUpdate
				id="ModuleTag_StructureUnpack"
				UnpackTime="0.2s" />
				
			<PassiveAreaEffectBehavior
				id="ModuleTag_RepairTurretHeal"
				EffectRadius="75"
				HealingPercentPerSecond="2%"				
				AffectWoundedOnly="true"
				AffectUnderAttack="true"
				DisabledTypesToProcess="HELD">
				<AllowFilter
					Rule="ANY"
                    Relationship="ALLIES" 
					Include="VEHICLE">
					<ExcludeThing>SovietScoutVehicle</ExcludeThing>
				</AllowFilter>
			</PassiveAreaEffectBehavior>

			<xi:include
				href="DATA:Includes/GenericBuildingRepair.xml" />
			<xi:include
				href="DATA:Includes/GenericAlliedBuildingSuicideNoSpawn.xml" />			
			<xi:include
				href="DATA:Includes/InfantryFighting/IF_SecondaryObjectListener.xml" />
			<xi:include
				href="DATA:Includes/InfantryFighting/IF_SubObjectsUpgrade.xml" />
			
			<LUAEventList
				id="ModuleTag_LUAEventList"
				EventListName="AlliedBaseDefenseRTFunctions"
			/>		
		</Behaviors>
		
		<AI>
			<AIUpdate
				id="ModuleTag_AI"
				AutoAcquireEnemiesWhenIdle="YES"
