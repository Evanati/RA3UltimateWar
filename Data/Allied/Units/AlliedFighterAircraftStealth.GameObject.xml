					<IncludeThing>AlliedFighterAircraftStealth</IncludeThing>
				</BroadcastObjectFilter>
				<ObjectStatusValidation
					ForbiddenStatus="IS_FIRING_WEAPON HAS_SECONDARY_DAMAGE TARGETED_FOR_REPAIR PARKED_AT_AIRFIELD" />
			</InvisibilityBroadcastUpdate>
			
