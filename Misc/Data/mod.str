// ZP01MapSounds
	HOTSPOT:ZP01_HOTSPOT_1_TITLE
		"Getting off"
	End
	
	HOTSPOT:ZP01_HOTSPOT_1_DESC
		"Get off the bus."
	End	

	DialogEvent:ZP01_C01_Voice01
		"Contact!"
	End
	
	DialogEvent:ZP01_C01_Voice02
		"We are under attack! Find cover!"
	End

	DialogEvent:ZP01_C01_Voice03
		"Report Comrade Lieutenant! We have encountered the Allied special forces and suffered heavy losses! Requesting immediate support!"
	End

	DialogEvent:ZP01_C01_Voice04
		"Comrade Captain! There are Allied special forces over there, we need support!"
	End
	
	DialogEvent:ZP01_C01_Voice05
		"[Radio] Comrade Lieutenant! We have encountered the Allied special forces and suffered heavy losses! Request immediate support!"
	End

	DialogEvent:ZP01_C01_Voice06
		"[Radio] Comrade Captain! There are Allied special forces over there, we need support!!"
	End

	DialogEvent:ZP01_C02_Voice01
		"What happened? Let's go check it out."
	End
	
	DialogEvent:ZP01_C02_Voice02
		"Damn it! Didn't you guys close the cage?"
	End

	DialogEvent:ZP01_C02_Voice03
		"Got it, we're on our way."
	End

	DialogEvent:ZP01_C02_Voice04
		"holy crap This place is about to explode!"
	End

	DialogEvent:ZP01_C03_Voice01
		"What's going on?"
	End

	DialogEvent:ZP01_C03_Voice02
		"Someone's dead, there's an enemy!!! Find cover!"
	End
	
	DialogEvent:ZP01_C03_Voice03
		"Did the guard run to slack off again?"
	End

	DialogEvent:ZP01_C03_Voice04
		"Where are those Allied soldiers? We can't let them run away!"
	End

	DialogEvent:ZP01_C03_Voice05
		"Welcome!"
	End

	DialogEvent:ZP01_C04_Voice01
		"Allied soldiers? our chief is living on the left mountain, go ask him you will get what you want."
	End

	DialogEvent:ZP01_C04_Voice02
		"The Soviets, they are poisoning the river in the north."
	End

	DialogEvent:ZP01_C05_Voice01
		"Commander, maybe we should take a different path. Look! That way, perhaps we could avoid conflicts with enemy main force."
	End

	DialogEvent:ZP01_C05_Voice02
		"Sir, I think we should open those cages before we heading there, These little guys gonna keep them busy for a while."
	End
	
	DialogEvent:ZP01_C05_Voice03
		"Shepherd, we have found the abandoned base. Requesting deploy an outpost, Coordinates 26 42 05."
	End

	DialogEvent:ZP01_C05_Voice04
		"Ah! This is the most disgusting place I've ever been."
	End

	DialogEvent:ZP01_C05_Voice05
		"Shepherd!We need back up, get us outta of here!"
	End	

	DialogEvent:ZP01_C06_Voice01
		"Glad you are here,sir.We were almost become a heap of ashes just now.Let's move out!"
	End

	DialogEvent:ZP01_C06_Voice02
		"Jesus......They are doing some researches on a kind of toxic weapon......I just thought that it was our end!"
	End
	
	DialogEvent:ZP01_C06_Voice03
		"This is Zulu101 calling Shepherd,enemy radar has been cut,coordinate sent,requesting support."
	End

	DialogEvent:ZP01_C06_Voice04
		"Holy crap!Look this place!"
	End

	DialogEvent:ZP01_C07_Voice01
		"We have received anonymous intel,that the Soviet Union is engaged in the development of secret weapons in a village in the occupied area of Romania.Regardless of the type of weapon, it will create a disadvantageous situation for the front line.You have been authorized as the commander of the special operation team.Our commando Tanya and two skilled snipers will follow your command."
	End	

	DialogEvent:ZP01_C07_Voice02
		"Lost connection with front line,mission aborted"
	End

	DialogEvent:ZP01_C07_Voice03
		"Received, reinforcement on route"
	End
	
	DialogEvent:ZP01_C07_Voice04
		"Request granted......Teleporting mobile outpost will arrive in 3...2...1..."
	End

	DialogEvent:ZP01_C07_Voice05
		"Now you can use any funds you collected to recruiting residents to fight for freedom.Good luck.Shepherd out."
	End

	DialogEvent:ZP01_C07_Voice06
		"Connection established,transmitting data......"
	End	

	DialogEvent:ZP01_C07_Voice07
		"Received,A helicopter is heading to the evacuating point in the northeast of Laboratory."
	End		

